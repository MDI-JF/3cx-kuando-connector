    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>3cxKuando</AssemblyName>
    <ApplicationTitle>3cxKuando</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
